# ---------------------------------------------------------------------------
# CohortIQ configuration. Copy to `.env` and fill in ONE provider key.
# With no key at all the app still runs end to end on the offline rubric
# engine — useful for judging without credentials, but questions come from
# templates rather than a model.
# ---------------------------------------------------------------------------

# --- Provider (pick one; "auto" uses whichever key is present) --------------
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama example (OpenAI-compatible):
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=qwen2.5-coder:7b

# --- Reliability -----------------------------------------------------------
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_BREAKER_THRESHOLD=4
LLM_BREAKER_COOLDOWN=30

# --- Server ----------------------------------------------------------------
DB_PATH=./data/sessions.db
SESSION_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=90
EXPOSE_TRACE=true
LOG_LEVEL=INFO
