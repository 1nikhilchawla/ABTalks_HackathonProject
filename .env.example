# ---------------------------------------------------------------------------
# CohortIQ configuration.
#
# EVERYTHING BELOW IS OPTIONAL. With no .env file at all, the app runs the
# complete interview — planning, adaptive questioning, scoring, reporting and
# the cohort view — on the built-in offline rubric engine. No API key, no
# billing account, no signup.
#
# The trade-off, stated plainly: offline, questions are composed from the
# curriculum's own learning objectives rather than written by a model, so they
# read more mechanical. Scoring is rule-based and tagged as such throughout the
# UI. Add a key below if you want model-written questions.
# ---------------------------------------------------------------------------

# --- Provider ---------------------------------------------------------------
# auto      = use whichever key is present, else the offline rubric engine
# heuristic = force offline even if a key exists
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free and local, if you want model-written questions without paying anyone:
# install Ollama, `ollama pull qwen2.5-coder:7b`, then set
#   LLM_PROVIDER=openai
#   OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_API_KEY=ollama
#   OPENAI_MODEL=qwen2.5-coder:7b

# --- Reliability ------------------------------------------------------------
LLM_TIMEOUT=45
LLM_MAX_RETRIES=2
LLM_BREAKER_THRESHOLD=4
LLM_BREAKER_COOLDOWN=30

# --- Server -----------------------------------------------------------------
DB_PATH=./data/sessions.db
SESSION_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=90
EXPOSE_TRACE=true
LOG_LEVEL=INFO

# Point at any curriculum JSON with the same shape. Nothing in the engine
# hardcodes day numbers.
# CURRICULUM_PATH=curriculum.platform.json
